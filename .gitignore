
# musubix3 generated caches
/.musubix/cache/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Projects created at runtime by the AI Data Scientist skill
/projects/

# Node / npm (bin wrapper has no runtime npm dependencies, but keep this
# clean if any tooling is added later)
node_modules/
npm-debug.log*

# Jupyter server runtime state (local to running instance)
/.jupyter/
/.jupyter_ystore.db
/.ipynb_checkpoints/

# Raw datasets fetched for benchmark runs (large, reproducible via scripts)
/benchmark/projects/*/data/
/benchmark/archive/*/project*/data/
/benchmark/archive/*/project*/data/**

# Jupyter notebooks (benchmark/experiment artifacts; not committed)
*.ipynb

# Benchmark run artifacts (keep only figures/ and white-paper)
/benchmark/*
!/benchmark/figures/
!/benchmark/white-paper-v0.2.0.md
